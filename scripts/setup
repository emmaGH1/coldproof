#!/usr/bin/env python3
import os
import secrets
from pathlib import Path

root = Path(__file__).resolve().parent.parent
local = root / ".local"
local.mkdir(exist_ok=True, mode=0o700)
env = root / "infra/.env"
if not env.exists():
    env.write_text(f"POSTGRES_PASSWORD={secrets.token_hex(24)}\nINGEST_TOKEN={secrets.token_hex(32)}\n")
    os.chmod(env, 0o600)
values = dict(line.split("=", 1) for line in env.read_text().splitlines() if "=" in line)
runtime = {
    "DATABASE_URL": f"postgres://coldproof:{values['POSTGRES_PASSWORD']}@localhost:5432/coldproof",
    "INGEST_TOKEN": values["INGEST_TOKEN"],
    "HORNET_URL": "http://localhost:14265",
}
for path in (root / "web/.env.local", local / "runtime.env"):
    path.write_text("\n".join(f"{k}={v}" for k, v in runtime.items()) + "\n")
    os.chmod(path, 0o600)
print("Local configuration ready; credentials are ignored by Git.")
